# ========================================
# .env.example — Copy to .env and fill in real values
# ========================================
# cp .env.example .env
#
# NEVER commit the actual .env file to git.
# ========================================

# ----- Code Signing (macOS) -----
# APPLE_DEVELOPER_ID=your_developer_id
# APPLE_TEAM_ID=your_team_id

# ----- AAX SDK Path (for Pro Tools support) -----
# AAX_SDK_PATH=/path/to/aax-sdk
